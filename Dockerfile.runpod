# RunPod-Image fuer Shiro: Trainer und Aufgabengenerator.
#
# Geprueft am 17.11.2026:
#   - mktool baut auf Linux in  5,2 s   und erzeugt korrekte Aufgaben
#   - shiro  baut mit CUDA in   3 min 48 (ohne GPU im Container)
#
# Bauen:   docker build -f Dockerfile.runpod -t shiro-trainer:0.2 .
# Starten: docker run --gpus all shiro-trainer:0.2 shiro train --config /data/train.toml

FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_TERM_COLOR=never \
    PATH=/root/.cargo/bin:/usr/local/cuda/bin:$PATH

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      curl ca-certificates build-essential pkg-config libssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Rust stable: burn 0.22 verlangt rustc 1.95 oder neuer.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal

WORKDIR /work

# Trainer zuerst: die Schicht aendert sich am seltensten.
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --features cuda

# Generator: eigener Crate, unabhaengig vom Trainer.
COPY tools/mktool/Cargo.toml ./tools/mktool/Cargo.toml
COPY tools/mktool/src ./tools/mktool/src
RUN cd tools/mktool && cargo build --release

# Beide Programme liegen danach unter /work/target/release und /work/tools/mktool/target/release.
# Ein Wrapper macht sie ohne Pfadwissen aufrufbar.
RUN printf '#!/bin/sh\nexec /work/target/release/shiro "$@"\n' > /usr/local/bin/shiro \
 && printf '#!/bin/sh\nexec /work/tools/mktool/target/release/mktool "$@"\n' > /usr/local/bin/mktool \
 && chmod +x /usr/local/bin/shiro /usr/local/bin/mktool

# Daten und Konfiguration werden zur Laufzeit gemountet.
# Der Generator erzeugt die Aufgaben im Pod; 1 Mrd Tokens brauchen keinen Upload.
VOLUME ["/data"]

CMD ["shiro", "--help"]
