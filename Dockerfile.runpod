# RunPod-Image fuer den Shiro-Trainer.
#
# Geprueft am 14.11.2026: `cargo build --release --features cuda` laeuft in diesem
# Basis-Image unter Linux in 3 Minuten 48 durch (ohne GPU, reiner Build).
#
# Bauen:   docker build -f Dockerfile.runpod -t shiro-trainer:0.1 .
# Starten: docker run --gpus all shiro-trainer:0.1 train --config /data/train.toml --backend cuda

FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_TERM_COLOR=never \
    PATH=/root/.cargo/bin:/usr/local/cuda/bin:$PATH

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      curl ca-certificates build-essential pkg-config libssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Rust stable: burn 0.22 verlangt rustc 1.95 oder neuer.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal

WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --features cuda

# Daten und Konfiguration werden zur Laufzeit gemountet, nicht ins Image gelegt:
# 475 MB Korpora gehoeren auf ein Volume, nicht in ein Image.
VOLUME ["/data"]

ENTRYPOINT ["/work/target/release/shiro"]
CMD ["--help"]
